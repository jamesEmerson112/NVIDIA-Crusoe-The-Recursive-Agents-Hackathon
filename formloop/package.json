{
	"name": "formloop",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Self-improving apartment intake form: agents rank listings from answers, a reviewer rewrites the form, held-out renters decide.",
	"packageManager": "npm@11.19.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.22.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": "^11.19.1",
			"onFail": "error"
		}
	},
	"scripts": {
		"loop": "node src/cli/loop.ts",
		"generation": "node src/cli/generation.ts",
		"eval": "node src/cli/eval.ts",
		"listings": "node src/cli/listings.ts",
		"serve": "node src/server.ts",
		"check": "tsc --noEmit -p .",
		"validate": "node src/cli/validate.ts",
		"factor": "node src/cli/factor.ts",
		"plan3d-check": "node src/cli/plan3d-check.ts"
	},
	"allowScripts": {},
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "~6.0.2"
	}
}
