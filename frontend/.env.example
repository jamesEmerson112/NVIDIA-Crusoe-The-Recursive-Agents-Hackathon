# Drizzle
DATABASE_URL=local.db

# Crusoe Managed Inference. Set it with `npm run set-key` rather than by hand:
# Vite expands $name in .env values even inside quotes, and Crusoe keys can contain $,
# so every $ must be written as \$. Leave unset to run the scripted mock agent.
CRUSOE_API_KEY=paste-your-key-here
# Optional overrides; check ids with `npm run models`.
# CRUSOE_AGENT_MODEL=openai/gpt-oss-120b
# CRUSOE_FAST_MODEL=deepseek-ai/Deepseek-V4-Flash
